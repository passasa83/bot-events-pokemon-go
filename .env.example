# ---------------------------------------------------------------
# Bot Discord « Events Pokémon GO » – Variables d'environnement
# Copiez ce fichier vers `.env` (ou renseignez-les dans le panel
# Pterodactyl > Variables) et remplissez les valeurs.
# Ne JAMAIS committer de token : ce fichier est un gabarit.
# ---------------------------------------------------------------

# [REQUIS] Token du bot (Portail développeur Discord > Bot > Token)
# ⚠️ Remplacez par VOTRE token, puis gardez ce fichier hors de Git (voir .gitignore).
DISCORD_TOKEN=VotreTokenIci

# [REQUIS] ID de l'application (Portail développeur Discord > General Information)
DISCORD_CLIENT_ID=123456789012345678

# [RECOMMANDÉ] ID de votre serveur de test : les commandes slash y sont
# disponibles immédiatement (au lieu d'attendre jusqu'à 1 h en global).
# Videz ce champ pour enregistrer les commandes en global.
TEST_GUILD_ID=

# [RECOMMANDÉ] ID Discord du propriétaire du bot (auteur du cahier des charges).
# Seul cet utilisateur peut utiliser /admin.
BOT_OWNER_ID=

# Source de données primaire (ScrapedDuck / LeekDuck) – dossier "data" du dépôt.
# Point d'accès : <base>/<fichier>.json
EVENTS_SOURCE_URL=https://raw.githubusercontent.com/bigfoott/ScrapedDuck/data
# Source de secours (utilisée si la source primaire est indisponible)
EVENTS_SOURCE_FALLBACK_URL=https://raw.githubusercontent.com/pokelitee/leak-duck/data
# Fichiers interrogés (relatifs à la base ci-dessus)
EVENTS_FILE=events.json
RAIDS_FILE=raids.json
EGGS_FILE=eggs.json

# Intervalle de collecte, en minutes (30 à 60 recommandé)
POLL_INTERVAL=30

# Délai de rappel avant le début d'un événement, en minutes (par défaut 60 = 1 h)
# Également modifiable par serveur avec /setup reminder
REMINDER_MINUTES=60

# Fuseau horaire d'affichage des heures converties (IANA)
DEFAULT_TIMEZONE=Europe/Paris

# Géocodage des lieux via OpenStreetMap Nominatim (1 requête/seconde maximum)
# 1 = activé, 0 = désactivé
GEOCODE_ENABLED=1
NOMINATIM_USER_AGENT=BotEventsPokemonGO/1.0 (contact : votre@email.fr)

# Niveau de log : debug | info | warn | error
LOG_LEVEL=info

# Chemin de la base SQLite (relatif au dossier du bot)
DB_PATH=./data/bot.db
